+        // Knife only: no pistols, bomb, money or map weapons. live.cfg sets all of these again.
+        _CsServer.ExecuteCommand("mp_ct_default_secondary \"\"; mp_t_default_secondary \"\"; mp_give_player_c4 0; mp_startmoney 0; mp_maxmoney 0; mp_buytime 0; mp_weapons_allow_map_placed 0; mp_free_armor 1; mp_freezetime 5; mp_roundtime 1.92; mp_roundtime_defuse 1.92");
