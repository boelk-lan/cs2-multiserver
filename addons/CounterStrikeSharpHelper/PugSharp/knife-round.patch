+        _KnifeRound = KnifeRoundState.None;
+        _CsServer.ExecuteCommand("mp_ct_default_secondary weapon_hkp2000; mp_t_default_secondary weapon_glock; mp_give_player_c4 1; mp_weapons_allow_map_placed 1; mp_free_armor 0");
+        _CsServer.LoadAndExecuteConfig("warmup.cfg");
