@@ -131,6 +131,44 @@ public class MatchTests
     }
 
 
+    [Fact]
+    public void MatchTestWithKnifeRound()
+    {
+        MatchConfig config = CreateExampleConfig(new List<string> { "de_dust2" });
+        config.KnifeRound = true;
+        var serviceProvider = CreateTestProvider();
+
+        var matchPlayers = new List<IPlayer>();
+        var csServer = serviceProvider.GetRequiredService<ICsServer>();
+        csServer.LoadAllPlayers().Returns(matchPlayers);
+
+        var match = serviceProvider.GetRequiredService<MatchFactory>().CreateMatch(config);
+
+        IPlayer player1 = CreatePlayerSub(0, 0); // Team1, starts as T
+        IPlayer player2 = CreatePlayerSub(1, 1); // Team2, starts as CT
+
+        ConnectPlayers(matchPlayers, match, player1, player2);
+        SetPlayersReady(match, player1, player2, MatchState.TeamVote);
+        csServer.Received().EndWarmup();
+
+        // No side vote while the knife round runs, round ends before its freeze time ended don't count
+        Assert.False(match.VoteTeam(player1, "T"));
+        Assert.False(match.KnifeRoundLive);
+        Assert.False(match.CompleteKnifeRound(Contract.Team.Terrorist));
+
+        // A draw restarts the knife round
+        match.KnifeRoundFreezeEnded();
+        Assert.True(match.KnifeRoundLive);
+        Assert.False(match.CompleteKnifeRound(Contract.Team.None));
+        Assert.False(match.KnifeRoundLive);
+
+        // CT (Team2) wins: only Team2 picks the side
+        match.KnifeRoundFreezeEnded();
+        Assert.True(match.CompleteKnifeRound(Contract.Team.CounterTerrorist));
+        Assert.Equal(MatchState.TeamVote, match.CurrentState);
+        VoteTeam(csServer, config, match, player1, player2, player2);
+    }
+
