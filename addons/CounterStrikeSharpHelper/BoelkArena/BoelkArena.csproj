<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the .NET runtime CounterStrikeSharp ships (api/CounterStrikeSharp.API.runtimeconfig.json) -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided at runtime by CounterStrikeSharp, so don't copy it -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.379" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
